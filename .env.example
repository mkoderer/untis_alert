# WebUntis-Konfiguration – kopieren nach .env und ausfüllen.
# .env ist in .gitignore und wird nie committet.

# Server und Schulname (aus der WebUntis-Login-URL: https://<SERVER>/WebUntis/?school=<SCHOOL>)
UNTIS_SERVER=
UNTIS_SCHOOL=

# Zugangsdaten
UNTIS_USER=
UNTIS_PASSWORD=

# ------------------------------------------------------------------
# ALERTING (Optional)
# Lass die Felder leer, die du nicht nutzen möchtest.
# ------------------------------------------------------------------

# 1. HomeAssistant Webhook
# In HomeAssistant: Einstellungen -> Automatisierungen -> Neu
# Auslöser: "Webhook", Webhook-ID z.B. "untis-alert-123"
# Die URL sieht dann etwa so aus: http://192.168.178.50:8123/api/webhook/untis-alert-123
HA_WEBHOOK_URL=

# 2. E-Mail
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=WebUntis Bot
EMAIL_FROM=
EMAIL_TO=
